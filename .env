# Loaded automatically by `docker compose` (it always looks for a file
# named .env in the same directory as docker-compose.yml).
# These values are substituted into docker-compose.yml wherever you see
# ${VAR_NAME}, AND passed into the web container as env vars.

APP_NAME=Docker Compose Lab
APP_COLOR=#16a34a
APP_ENV=development
WEB_PORT=8080
REDIS_PORT=6379
DB_PASSWORD=password@1234